<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <runtime>
    <!-- DLLs from the downloaded zip carry Mark-of-the-Web; without this the
         Assembly.LoadFile probe throws 0x80131515 and CefSharp never loads. -->
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>